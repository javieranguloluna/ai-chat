# Clave de NVIDIA NIM (build.nvidia.com). Requerida para el endpoint /api/chat.
NIM_API_KEY=

# Opcionales (valores por defecto en apps/backend/src/app/chat/chat.controller.ts)
# nvidia/nemotron-3-nano-30b-a3b llegó a EOL el 2026-09-01; verificá el catálogo
# vigente en https://docs.api.nvidia.com/nim/reference/llm-apis
NIM_MODEL=openai/gpt-oss-20b
NIM_BASE_URL=https://integrate.api.nvidia.com/v1
SYSTEM_PROMPT=Eres un asistente útil. Responde de forma clara y concisa.
