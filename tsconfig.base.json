{
  "compileOnSave": false,
  "compilerOptions": {
    "rootDir": ".",
    "importHelpers": true,
    "isolatedModules": true,
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noUnusedLocals": true,
    "skipLibCheck": true,
    "strict": true,
    "target": "es2022",
    "noUncheckedSideEffectImports": false,
    "types": ["*"],
    "paths": {
      "@org/models": ["./libs/shared/models/src/index.ts"]
    }
  }
}
